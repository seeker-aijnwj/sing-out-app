# Copiez ce fichier vers `.env.local` (jamais commité) et renseignez les
# valeurs de votre projet Firebase pour activer la synchronisation.
# Console Firebase → Paramètres du projet → Vos applications → Config SDK.
#
# Tant que ces variables sont absentes ou incomplètes, Sing Out fonctionne
# entièrement en local : aucune erreur, aucun appel réseau vers Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
